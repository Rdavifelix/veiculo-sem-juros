# Copie para .env.local e preencha com o projeto Supabase do Veículo Sem Juros.
# Chaves públicas (vão para o navegador):
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço — SÓ no servidor (rotas/server actions). Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Domínio público do site (usado em metadados e links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# IA das análises Premium (Claude). Só no servidor. Sem ela, pedir análise registra erro e o admin vê o motivo.
ANTHROPIC_API_KEY=
# Funil /conversa (chat estilo WhatsApp). Link do botão final de compra; sem ele, cai no WhatsApp abaixo e, sem ambos, em /login.
NEXT_PUBLIC_CHECKOUT_URL=
# Número do WhatsApp comercial só com dígitos, com DDI (ex.: 5511999999999).
NEXT_PUBLIC_WHATSAPP=
# Preço anunciado no funil (texto livre, ex.: R$ 47,00).
NEXT_PUBLIC_PRECO_ACESSO=
